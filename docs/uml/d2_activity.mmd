  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Arial, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#FCE4EC",
    "primaryTextColor": "#2E1045",
    "primaryBorderColor": "#7030A0",
    "lineColor": "#7030A0",
